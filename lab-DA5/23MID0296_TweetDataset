   "source": [
    "def vader_label(text):\n",
    "    compound = analyzer.polarity_scores(text)['compound']\n",
    "    if compound >= 0.05:\n",
    "        return 'positive'\n",
    "    if compound <= -0.05:\n",
    "        return 'negative'\n",
    "    return 'neutral'"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 32,
   "id": "2bc565d1-e9ec-4286-ab77-310d7031d224",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "VADER macro F1 0.5206462567349533\n"
     ]
    }
   ],
   "source": [
    "vader_pred = X_test.map(vader_label)\n",
    "vader_macro_f1 = f1_score(y_test, vader_pred, average='macro')\n",
    "print('VADER macro F1', vader_macro_f1)"
   ]
  },
